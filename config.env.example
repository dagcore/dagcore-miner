# ---------------------------------------------------------------------------
# DAGCore Miner - configuration
#
# Installed to /etc/dagcore-miner/config.env. "make install" copies this file
# there ONLY if it does not exist yet, so an operator's config is never
# overwritten by an upgrade.
#
# Format: KEY=value, one per line. Blank lines and lines starting with # are
# ignored. Values are taken literally - no quotes, no shell expansion.
#
# Precedence: command line > this file > built-in defaults. Autotune keys can
# additionally be overridden by environment variables of the same name.
#
# The miner reads this file; it never writes it. Settings changed from the
# dashboard land in /var/lib/dagcore-miner/overrides.env instead.
# ---------------------------------------------------------------------------

# ---- Pool ----------------------------------------------------------------
# WALLET is the only required key. Replace the placeholder below.
WALLET=0x0000000000000000000000000000000000000000
POOL=stratum.dagcore.net
PORT=3334
# Worker name. Sent as the Stratum password field, because the pool wants a
# bare wallet address as the username. The current DagCore pool does not
# support worker names - its docs state that address.worker logins are
# rejected and there is no per-worker list - so this has no visible effect on
# the pool site. It is still sent, in case the pool reads the field later.
WORKER=dagcore
# Pool password. Most pools ignore it; leave empty unless yours asks for one.
# WORKER and PASSWORD share the Stratum password field: if WORKER is set, it
# wins and PASSWORD is not sent.
PASSWORD=

# ---- CPU mining ----------------------------------------------------------
# 0  = no CPU threads, GPU only (default)
# -1 = auto-detect (half the logical cores)
# N  = exactly N threads
THREADS=0
# 1-100: share of CPU time each thread may use.
CPU_LIMIT=100
# 1 = run at lowest scheduling priority.
LOW_PRIORITY=0

# ---- Share submission ----------------------------------------------------
# Multiplier on the share threshold, >= 1.0. Higher submits fewer, safer shares.
SUBMIT_MARGIN=1.0
# 1 = raise the margin automatically after low-difficulty rejects.
AUTO_THRESHOLD=1

# ---- GPU -----------------------------------------------------------------
# -1 = auto, 0 = disabled, 1 = enabled
GPU_ENABLED=1
GPU_PLATFORM=0
# Single index, a comma list (0,1), or "all".
GPU_DEVICE=0
# 0-100, or one value per card: 80,60
GPU_INTENSITY=80
# 1-100: GPU duty-cycle limit.
GPU_THROTTLE=100
# GPU power limit in watts, applied with nvidia-smi at startup. Must be within
# the card's own min/max envelope. Empty or 0 = leave the card's setting alone.
# The dashboard writes this to /var/lib/dagcore-miner/overrides.env instead,
# which is loaded on top of this file.
GPU_POWER_LIMIT=0
# GPU clock locks in MHz, applied with nvidia-smi -lgc / -lmc at startup.
# 0 = leave the card's own clock management alone (default).
# Valid values come from the card's supported-clocks table, which is narrower
# than the advertised boost ceiling: on an RTX 3080 clocks.max.memory reports
# 10101 MHz but the highest value -lmc accepts is 9501. /metrics exposes both,
# and the API validates against the supported range.
GPU_CORE_CLOCK=0
GPU_MEM_CLOCK=0
# How the VRAM-fitted work-item count is rounded down:
#   pow2 = down to a power of two (default; measured fastest on RTX 3080)
#   N    = down to a multiple of N, where N is a multiple of 32
GPU_ALIGN=pow2

# ---- Autotune (off by default) -------------------------------------------
# Sweeps work sizes and kernel modes once, then caches the winner.
AUTOTUNE=0
# 1 = retune even when a valid cache exists.
AUTOTUNE_FORCE=0
# Seconds per candidate. Below ~60 the measurement gets noisy.
AUTOTUNE_TRIAL_SECONDS=60
AUTOTUNE_BATCHES=1024,2048,4096,8192
AUTOTUNE_KERNEL_MODES=split,legacy
# Cache file. Empty = $XDG_CACHE_HOME/dagcore-miner/autotune.json, falling back
# to $HOME/.cache/dagcore-miner/autotune.json.
AUTOTUNE_CACHE=
# Batch duration above which the autotune score starts penalising latency, ms.
TARGET_BATCH_MS=1500

# ---- Metrics and dashboard -----------------------------------------------
METRICS_PORT=8881
# Interface to bind. 127.0.0.1 keeps it on this host; 0.0.0.0 exposes the
# endpoint - including the full wallet address, unauthenticated - to the LAN.
METRICS_BIND=127.0.0.1
# Directory holding the dashboard's index.html. Empty = no dashboard served.
DASHBOARD_DIR=/usr/local/share/dagcore-miner/dashboard
