# ---------------------------------------------------------------------------
# DAGCore Miner - configuration
#
# Installed to /etc/dagcore-miner/config.env. "make install" copies this file
# there ONLY if it does not exist yet, so an operator's config is never
# overwritten by an upgrade.
#
# Format: KEY=value, one per line. Blank lines and lines starting with # are
# ignored. Values are taken literally - no quotes, no shell expansion.
#
# Precedence: command line > this file > built-in defaults. Autotune keys can
# additionally be overridden by environment variables of the same name.
#
# The miner reads this file; it never writes it. Settings changed from the
# dashboard land in /var/lib/dagcore-miner/overrides.env instead.
# ---------------------------------------------------------------------------

# ---- Pool ----------------------------------------------------------------
# WALLET is the only required key. Replace the placeholder below.
WALLET=0x0000000000000000000000000000000000000000
POOL=stratum.dagcore.net
PORT=3334
# Pool password. Most pools ignore it; leave empty unless yours asks for one.
# (There is no worker name: the pool takes a bare wallet address and has no
# per-machine names. An old WORKER= line is still read and does no harm.)
PASSWORD=

# ---- CPU mining ----------------------------------------------------------
# 0  = no CPU threads, GPU only (default)
# -1 = auto-detect (half the logical cores)
# N  = exactly N threads
THREADS=0
# 1-100: share of CPU time each thread may use.
CPU_LIMIT=100
# 1 = run at lowest scheduling priority.
LOW_PRIORITY=0

# ---- Share submission ----------------------------------------------------
# Multiplier on the share threshold, >= 1.0. Higher submits fewer, safer shares.
SUBMIT_MARGIN=1.0
# 1 = raise the margin automatically after low-difficulty rejects.
AUTO_THRESHOLD=1
# Minimum gap between two share submissions, in ms (0-1000, 0 = no limit).
# A share found inside the gap is dropped, never sent: the "dropped" count.
# 5 ms is below the time a GPU batch takes (about 10 ms on an RTX 3080), so a
# share from each batch gets through even while the pool's difficulty is still
# low after a (re)connection. The old default, 20 ms, dropped every other share
# in those minutes. In normal running any of these costs next to nothing.
SUBMIT_MIN_INTERVAL_MS=5

# ---- GPU -----------------------------------------------------------------
# -1 = auto, 0 = disabled, 1 = enabled
GPU_ENABLED=1
GPU_PLATFORM=0
# Which graphics cards to mine on:
#   all   every card the driver exposes on GPU_PLATFORM - what a rig with more
#         than one card almost always wants, since hashrate simply adds up
#   0     only the first card
#   0,1   a chosen list
# The installer sets this to "all" by itself when it finds more than one card.
# Leaving it at 0 on a two-card rig quietly mines with half the hardware.
GPU_DEVICE=0
# 0-100, or one value per card: 80,60
GPU_INTENSITY=80
# 1-100: GPU duty-cycle limit.
GPU_THROTTLE=100
# GPU power limit in watts, applied with nvidia-smi at startup. Must be within
# the card's own min/max envelope. Empty or 0 = leave the card's setting alone.
# The dashboard writes this to /var/lib/dagcore-miner/overrides.env instead,
# which is loaded on top of this file.
GPU_POWER_LIMIT=0
# GPU clock locks in MHz, applied through NVML at startup (the same call
# nvidia-smi -lgc/-lmc and nvidia_oc use). 0 = leave the card's own clock
# management alone (default).
#
# The valid range is offset-aware and is read from the card, not from the
# supported-clocks table: a memory offset displaces that table by half the
# offset. On an RTX 3080 with GPU_MEM_OFFSET=1200 the base table tops out at
# 9501 MHz but the card accepts a lock up to 10101, and 9851 is a real entry
# (9251 + 600). Validating against the base table would reject a setting the
# card is already running.
#
# Offsets are applied before locks at startup, because an offset changes which
# clocks a lock may use.
# Stored as a STEP of the card's base clock table, not as the MHz the card
# ends up running. An offset displaces the whole table, so an absolute value
# would go stale the moment the offset changed; a step does not, and the lock
# is re-applied at the same step automatically.
# Effective frequency = step + shift, where the shift is half the memory
# offset (measured) and the core offset as-is. On rig1: step 9251 with a
# +1200 memory offset gives 9851 MHz.
# 0 = leave the card's own clock management alone (default).
GPU_CORE_CLOCK_BASE=0
GPU_MEM_CLOCK_BASE=0
# Retired absolute keys. Still read once, to migrate an older config to the
# step form; then written back as 0. Do not set them by hand.
#GPU_CORE_CLOCK=0
#GPU_MEM_CLOCK=0
# Clock offsets in MHz, applied through NVML (nvidia-smi cannot set these).
# Signed: negative undervolts the VF curve, positive pushes it. Leave the keys
# out entirely to not touch the card's current offsets - 0 is a real value that
# clears an offset someone else set, not "no opinion".
# Guard range: core -1000..+1500, memory -2000..+4000. NVML has the final say
# and its refusal is reported verbatim.
# The dashboard writes these only after a 10-minute trial with no new rejected
# shares, so a value that destabilises the card never reaches the disk.
#GPU_CORE_OFFSET=0
#GPU_MEM_OFFSET=0
# How the VRAM-fitted work-item count is rounded down:
#   pow2 = down to a power of two (default; measured fastest on RTX 3080)
#   N    = down to a multiple of N, where N is a multiple of 32
GPU_ALIGN=pow2

# ---- Autotune (off by default) -------------------------------------------
# Sweeps work sizes and kernel modes once, then caches the winner.
AUTOTUNE=0
# 1 = retune even when a valid cache exists.
AUTOTUNE_FORCE=0
# Seconds per candidate. Below ~60 the measurement gets noisy.
AUTOTUNE_TRIAL_SECONDS=60
AUTOTUNE_BATCHES=1024,2048,4096,8192
AUTOTUNE_KERNEL_MODES=split,legacy
# Cache file. Empty = $XDG_CACHE_HOME/dagcore-miner/autotune.json, falling back
# to $HOME/.cache/dagcore-miner/autotune.json.
AUTOTUNE_CACHE=
# Batch duration above which the autotune score starts penalising latency, ms.
TARGET_BATCH_MS=1500

# ---- Metrics and dashboard -----------------------------------------------
METRICS_PORT=8881
# Interface to bind. 127.0.0.1 keeps it on this host; 0.0.0.0 exposes the
# endpoint - including the full wallet address, unauthenticated - to the LAN.
METRICS_BIND=127.0.0.1
# Directory holding the dashboard's index.html. Empty = no dashboard served.
DASHBOARD_DIR=/usr/local/share/dagcore-miner/dashboard
